{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cle1"
  ],
  "functions": {
    "app/api/bench/jazz/route.ts": {
      "regions": [
        "fra1"
      ]
    },
    "app/api/bench/jazz-vercel/route.ts": {
      "regions": [
        "fra1"
      ]
    },
    "app/api/bench/turso/route.ts": {
      "regions": [
        "dub1"
      ]
    },
    "app/jazz/[...path]/route.ts": {
      "regions": [
        "fra1"
      ]
    },
    "app/api/million-rows/*/route.ts": {
      "regions": [
        "fra1"
      ]
    },
    "app/api/bench/postgres/route.ts": {
      "regions": [
        "iad1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/monitor/run",
      "schedule": "*/15 * * * *"
    }
  ]
}
